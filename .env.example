# ── ScholarLens environment ──────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# ── Required ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Supabase Postgres URI (pgvector enabled)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# Voyage AI key for embeddings + reranking (voyageai.com)
VOYAGE_API_KEY=

# Encryption key for tenant BYOK keys (REQUIRED for BYOK). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must stay stable — changing it makes already-stored keys undecryptable.
FERNET_KEY=

# ── Optional external APIs ───────────────────────────────────
SEMANTIC_SCHOLAR_KEY=
# OpenAlex "polite pool" contact + optional free key (exempts search from the anonymous limit)
CONTACT_EMAIL=
OPENALEX_API_KEY=
# Gmail SMTP for monitor digests (use an app password, not your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Admin ────────────────────────────────────────────────────
# Guards /api/admin/*. Leave UNSET in prod to keep those endpoints locked (403).
ADMIN_TOKEN=

# ── Auth / cookies ───────────────────────────────────────────
# "password" (built-in bcrypt + sessions) or "clerk" (verify Clerk JWTs).
AUTH_PROVIDER=password
# Only when AUTH_PROVIDER=clerk:
# CLERK_ISSUER=
# CLERK_JWKS_URL=
# optional: email lookup when the JWT has no email claim
# CLERK_SECRET_KEY=
SESSION_TTL_DAYS=7
# Must be false on http://localhost (the browser drops Secure cookies over http).
COOKIE_SECURE=false
# Cross-site cookie policy. Production (frontend and API on different sites,
# e.g. Vercel + Render) needs "none" — which requires COOKIE_SECURE=true —
# or POSTs arrive without the session cookie. Keep "lax" for local dev.
COOKIE_SAMESITE=lax

# ── Deploy ───────────────────────────────────────────────────
# ENV=development enables /api/docs; anything else (default) hides it.
ENV=development
# CORS: e.g. https://scholarlens.vercel.app (comma-separate several)
FRONTEND_ORIGIN=
# temporary PDF staging dir; defaults to ./data/uploads
# UPLOAD_DIR=
MAX_UPLOAD_MB=25

# ── Monitoring ───────────────────────────────────────────────
# true: run the daily scan inside the web process. false: run
# `python -m jobs.run_monitor` as a separate cron job (recommended in prod).
ENABLE_INPROCESS_MONITOR=true
# UTC
MONITOR_HOUR=9
MONITOR_MINUTE=0
MONITOR_MAX_PER_SOURCE=5

# ── Free tier on the server key (BYOK users are uncapped) ───
FREE_ACTION_LIMIT=15
FREE_SONNET_LIMIT=2

# ── Search ───────────────────────────────────────────────────
SEARCH_RERANK=true
SEARCH_RERANK_FETCH=30
# RERANK_MODEL=rerank-2.5-lite

# ── Rate limiting (slowapi syntax "N/hour"); unset = defaults ─
# only if running >1 instance
# RATE_LIMIT_STORAGE_URI=redis://host:6379
# RL_DEFAULT=1000/hour  RL_UPLOAD=10/hour  RL_LOGIN=10/minute  (see config/settings.py)
